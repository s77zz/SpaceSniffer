<Window x:Class="SpaceSniffer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SpaceSniffer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:SpaceSniffer.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="700"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        ui:WindowHelper.UseModernWindowStyle="True"
        WindowState="Maximized"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Menu  -->
        <Menu IsMainMenu="True" Visibility="Collapsed">
            <MenuItem Header="_File">
                <MenuItem Command="{Binding SelectFolderCommand}" Header="Select _Folder..." />
                <MenuItem Command="{Binding SelectDriveCommand}" Header="Select _Drive..." />
                <MenuItem Command="{Binding ScanAllDrivesCommand}" Header="Scan _All Drives" />
                <Separator />
                <MenuItem Command="{Binding GoBackCommand}"
                          Header="← _Back"
                          InputGestureText="Alt+Left"
                          IsEnabled="{Binding CanGoBack}" />
                <Separator />
                <MenuItem Click="OnExitClick" Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Scan">
                <MenuItem Command="{Binding SelectFolderCommand}" Header="Select _Folder..." />
                <MenuItem Command="{Binding SelectDriveCommand}" Header="Select _Drive..." />
                <MenuItem Command="{Binding ScanAllDrivesCommand}" Header="_All Drives" />
            </MenuItem>
        </Menu>

        <!--  Fluent Toolbar  -->
        <Border Grid.Row="0"
                Margin="0"
                Padding="8,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <ui:CommandBar Background="Transparent"
                           DefaultLabelPosition="Right"
                           IsOpen="True"
                           OverflowButtonVisibility="Collapsed">
                <ui:AppBarButton Command="{Binding GoBackCommand}"
                                 IsEnabled="{Binding CanGoBack}"
                                 Label="Back"
                                 ToolTip="Go back to previous folder (Alt+Left)">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>

                <ui:AppBarSeparator />

                <ui:AppBarButton Command="{Binding SelectFolderCommand}"
                                 Label="Folder"
                                 ToolTip="Select a folder to scan">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>

                <ui:AppBarButton Command="{Binding SelectDriveCommand}"
                                 Label="Drive"
                                 ToolTip="Select a drive to scan">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEDA2;" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>

                <ui:AppBarButton Command="{Binding ScanAllDrivesCommand}"
                                 Label="All Drives"
                                 ToolTip="Scan all available drives">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71D;" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>

                <ui:AppBarSeparator />

                <ui:AppBarButton Command="{Binding CancelScanCommand}"
                                 Label="Cancel"
                                 ToolTip="Cancel current scan"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
            </ui:CommandBar>
        </Border>

        <!--  Treemap Control  -->
        <controls:TreemapControl x:Name="Treemap"
                                 Grid.Row="1"
                                 Margin="4"
                                 ItemsSource="{Binding CurrentRoot}" />

        <!--  Progress bar overlay  -->
        <ProgressBar Grid.Row="1"
                     Height="4"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--  Status Bar  -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Margin="5" Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Margin="5" Text="{Binding ScanProgressText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
